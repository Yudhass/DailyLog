DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=db_dailylog
JWT_SECRET="ganti-dengan-secret-acak"
PORT=5000

# Opsional: pengingat email harian (kalau kosong, hanya pengingat dalam aplikasi yang aktif)
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER="email@kamu.com"
# SMTP_PASS="app-password"
# SMTP_FROM="DailyLog <email@kamu.com>"
# REMINDER_CRON="0 7 * * *"

# Opsional F2/F1: LLM OpenAI-compatible (kalau kosong, pakai mesin lokal)
# LLM_API_URL="https://api.openai.com/v1/chat/completions"
# LLM_API_KEY="sk-..."
# LLM_MODEL="gpt-4o-mini"
# TZ="Asia/Jakarta"

# Opsional F3: Bot Telegram (buat via @BotFather)
# TELEGRAM_BOT_TOKEN="123456:ABC..."
# TELEGRAM_BOT_USERNAME="DailyLogBot"
# TELEGRAM_WEBHOOK_SECRET="string-acak-untuk-verifikasi-webhook"

# Opsional F4: Web Push VAPID (hasilkan via: npx web-push generate-vapid-keys)
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:admin@dailylog.local"
